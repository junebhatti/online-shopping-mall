# Copy to .env.local at the repo root. Never commit .env.local.

# Postgres. Local default comes from `npm run db:start`; production is a Neon connection string.
DATABASE_URL=postgres://mall@localhost:54329/mall

# Owner login. Anyone can browse; only the owner can rate, save, or change settings.
OWNER_PASSWORD=
# Random string used to sign the owner session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# eBay Browse API (developer.ebay.com, production keyset). Set up together with Junaid.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Claude API for the taste judge. Optional: without it, ranking uses embeddings only and every run logs that.
ANTHROPIC_API_KEY=

# Daily digest email via Resend (resend.com). onboarding@resend.dev can only send to the
# address you signed up with, which is all a personal digest needs.
RESEND_API_KEY=
DIGEST_TO=
# DIGEST_FROM="Personal Mall <onboarding@resend.dev>"
# Local hour after which the daily digest goes out (default 8).
# DIGEST_HOUR=8
# Public URL of the deployed site, for links and cutout images in the digest.
SITE_URL=
